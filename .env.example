# --- Flask session security ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Generation (production app) ---
# Gemini API key (free tier) — get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (defaults to gemini-2.5-flash-lite)
GEMINI_MODEL=

# --- Initial admin account (used by scripts/init_db.py) ---
ADMIN_EMAIL=admin@local.dev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# --- Optional: override the SQLite location ---
# DATABASE_URL=sqlite:////absolute/path/to/ipc_app.db

# --- Dataset generation (training pipeline only, not used by the app) ---
GROQ_API_KEY=
