# --- Flask session security ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database ---
# Option A (recommended, required for persistent data on Render):
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ipc_app
# Option B: full SQLAlchemy URL (used only when MYSQL_HOST is unset)
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/ipc_app?charset=utf8mb4
# Option C: omit both to fall back to a local SQLite file in instance/

# --- LLM providers (tried in this order, first success wins) ---
# 1) Groq — free tier, fastest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=12
# 2) MiniMax — very low cost, OpenAI-compatible
MINIMAX_API_KEY=
# Leave empty to use the built-in order: /v1/chat/completions, then legacy.
MINIMAX_BASE_URL=
MINIMAX_MODEL=abab6.5s
MINIMAX_TIMEOUT=15
# 3) Gemini — free tier, ultimate fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=15

# Shared generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Retrieval ---
# numpy = in-memory .npz index (default, no extra deps)
# chroma = ChromaDB (only if you install chromadb + langchain-chroma yourself)
VECTOR_BACKEND=numpy
# hf = sentence-transformers/torch | onnx = onnxruntime (light)
EMBEDDING_BACKEND=hf
# Optional torch tuning when EMBEDDING_BACKEND=hf
TORCH_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# --- Initial admin account ---
# Created automatically on startup if missing. If ADMIN_PASSWORD is set, an
# existing admin's password is re-synced to this value on every boot.
ADMIN_EMAIL=admin@local.dev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
