# --- Flask session security ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database ---
# Option A (recommended, required for persistent data on Render):
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ipc_app
# Option B: full SQLAlchemy URL (overrides nothing if MYSQL_HOST is set)
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/ipc_app?charset=utf8mb4
# Option C: omit both to fall back to a local SQLite file in instance/

# --- Generation ---
GEMINI_API_KEY=
# Optional model override (defaults to gemini-2.5-flash-lite)
GEMINI_MODEL=
# sdk = langchain-google-genai (local dev) | rest = plain HTTPS (light, for free hosting)
GENERATION_BACKEND=sdk

# --- Retrieval ---
# chroma = ChromaDB (local dev) | numpy = in-memory .npz index (light)
VECTOR_BACKEND=chroma
# hf = sentence-transformers/torch | onnx = onnxruntime (light)
EMBEDDING_BACKEND=hf

# --- Initial admin account (used by scripts/init_db.py) ---
ADMIN_EMAIL=admin@local.dev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# --- Dataset generation (training pipeline only, not used by the app) ---
GROQ_API_KEY=
